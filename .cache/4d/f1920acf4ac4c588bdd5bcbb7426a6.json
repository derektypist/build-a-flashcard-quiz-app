l":{"line":234,"column":2},"generated":{"line":1,"column":3155}},{"source":"styles.css","name":null,"original":{"line":235,"column":4},"generated":{"line":1,"column":3160}},{"source":"styles.css","name":null,"original":{"line":236,"column":2},"generated":{"line":1,"column":3173}},{"source":"styles.css","name":null,"original":{"line":238,"column":2},"generated":{"line":1,"column":3174}},{"source":"styles.css","name":null,"original":{"line":239,"column":4},"generated":{"line":1,"column":3206}},{"source":"styles.css","name":null,"original":{"line":240,"column":2},"generated":{"line":1,"column":3220}},{"source":"styles.css","name":null,"original":{"line":242,"column":2},"generated":{"line":1,"column":3221}},{"source":"styles.css","name":null,"original":{"line":243,"column":4},"generated":{"line":1,"column":3232}},{"source":"styles.css","name":null,"original":{"line":243,"column":17},"generated":{"line":1,"column":3244}},{"source":"styles.css","name":null,"original":{"line":244,"column":4},"generated":{"line":1,"column":3245}},{"source":"styles.css","name":null,"original":{"line":245,"column":2},"generated":{"line":1,"column":3261}},{"source":"styles.css","name":null,"original":{"line":247,"column":2},"generated":{"line":1,"column":3262}},{"source":"styles.css","name":null,"original":{"line":248,"column":4},"generated":{"line":1,"column":3269}},{"source":"styles.css","name":null,"original":{"line":249,"column":2},"generated":{"line":1,"column":3286}},{"source":"styles.css","name":null,"original":{"line":250,"column":0},"generated":{"line":1,"column":3287}}],"sources":{"styles.css":"/* Import Fonts */\n@import url('https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap');\n\n/* Body */\nbody {\n  font-family: Roboto, Arial, Verdana, sans-serif;\n  margin: 0;\n  height: 100%;\n  place-items: center;\n  background-color: #333333;\n  color: #D2FFFF;\n  min-height: 100vh;\n  padding: 1rem;\n}\n\nh1 {\n  text-align: center;\n  font-weight: 700;\n  color: #FCFFCD;\n  margin-bottom: 2rem; \n}\n\n.app-container {\n  display: flex;\n  gap: 2rem;\n  width: 100%;\n  max-width: 1200px;\n}\n\n.flashcard-panel {\n  flex: 2;\n}\n\n.controls-panel {\n  flex: 1;\nbackground-color: linear-gradient(to bottom,  #4c4c4c 0%,#595959 12%,#666666 25%,#474747 39%,#2c2c2c 50%,#000000 51%,#111111 60%,#2b2b2b 76%,#1c1c1c 91%,#131313 100%); \nborder-radius: 20px;\npadding: 2rem;\n}\n\nhr {\n  border: none;\n  border-top: 1px solid #FFFF99;\n  margin: 2rem 0;\n}\n\n#flashcard-body {\n  background-color: linear-gradient(to bottom,  #4c4c4c 0%,#595959 12%,#666666 25%,#474747 39%,#2c2c2c 50%,#000000 51%,#111111 60%,#2b2b2b 76%,#1c1c1c 91%,#131313 100%);\n  border-radius: 20px;\n  padding: 2rem 2.5rem;\n  height: 500px;\n  border: 1px solid #ffff99;\n  display: flex;\n  flex-direction: column;\n}\n\n.flashcard-container {\n  display: flex;\n  flex-direction: column;\n  margin-bottom: 1.5rem;\n  perspective: 1000px;\n}\n\n.flashcard {\n  height: 250px;\n  background-color: #333333;\n  border: 1px solid #ffff99;\n  border-radius: 12px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 2rem;\n  text-align: center;\n  font-size: 2rem;\n  transition: transform 0.2s ease-in-out;\n  margin-bottom: 0;\n  position: relative;\n  transform-style: preserve-3d;\n}\n\n.flashcard.flipped {\n  transform: rotateY(180deg);\n}\n\n.card-inner {\n  position: relative;\n  height: 100%;\n  width: 100%;\n  transform-style: preserve-3d;\n}\n\n\n.card-front, .card-back {\n  position: absolute;\n  width: 100%;\n  height: 100%;\n  backface-visibility: hidden;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  padding: 2rem;\n}\n\n\n.card-front {\n  transform: rotateY(0deg);\n}\n\n.card-back {\n  transform: rotateY(180deg);\n}\n\n.flashcard:hover {\n  transform: translateY(-5px);\n}\n\n.button-group {\n  display: flex;\n  gap: 1rem;\n  justify-content: center;\n  flex-wrap: wrap;\n  margin-bottom: 1.5rem;\n}\n\n.card-actions {\n  display: flex;\n  gap: 1rem;\n}\n\n#cards-list {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.5rem;\n  justify-content: center;\n  margin-top: 1rem;\n}\n\n\n.selected {\n  background: #86D3FF;\n}\n\nbutton {\n  background-color: #7CBBFF;\n  color: #ffffff;\n  font-family: inherit;\n  border: none;\n  border-radius: 8px;\n  padding: 12px 24px;\n  font-weight: 500;\n  font-size: 1rem;\n  cursor: pointer;\n  transition: background-color 0.2s ease,\n  transform 0.1s ease;\n  width: 100%;\n}\n\nbutton:hover {\n  background: #86D3FF;\n}\n\nbutton:active {\n  transform: scale(0.98);\n}\n\nbutton.delete-btn {\n  background-color: #4A4E57;\n}\n\nbutton.delete-btn:hover {\n  background-color: #6065CF;\n}\n\n.entry-form {\n  display: flex;\n  flex-direction: column;\n  gap: 1rem;\n  text-align: left;\n  margin-bottom: 1.5rem;\n}\n\n.entry-form label {\n  font-size: 0.9rem;\n  color: #86FFD3;\n  font-weight: 500;\n}\n\n.entry-form textarea {\n  width: 100%;\n  padding: 12px;\n  background-color: #333333;\n  border: 1px solid #FFFF99;\n  border-radius: 8px;\n  color: #D2FFFF;\n  font-family: inherit;\n  font-size: 1rem;\n  resize: vertical;\n  box-sizing: border-box;\n  min-height: 80px;\n}\n\n.entry-form textarea:focus {\n  outline: none;\n  border-color: #86D3FF;\n  box-shadow: 0 0 0 3px rgba(0, 170, 255, 0.3);\n}\n\n\n.error {\n  color: #FF6161;\n  text-align: center;\n  min-height: 1.2em;\n}\n\n@media (max-width: 992px) {\n  .app-container {\n    flex-direction: column;\n    align-items: center;\n    gap: 1.5rem;\n  }\n\n  .flashcard-panel, .controls-panel {\n    width: 100%;\n    max-width: 700px;\n  }\n\n  #flashcard-body {\n    height: auto;\n    min-height: 400px;\n  }\n}\n\n@media (max-width: 480px) {\n  body {\n    padding: 0.5rem;\n  }\n\n  .controls-panel, #flashcard-body {\n    padding: 1.5rem;\n  }\n\n  .flashcard {\n    height: 200px;\n    font-size: 1.5rem;\n  }\n\n  button {\n    padding: 14px 20px;\n  }\n}\n"},"lineCount":null}},"error":null,"hash":"6db4c946890adc3180e7c1012223065a","cacheData":{"env":{}}}